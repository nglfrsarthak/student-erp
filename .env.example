# Copy to .env and adjust. Never commit .env.

# --- Postgres (used by docker compose) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_secret
POSTGRES_DB=student_erp
POSTGRES_PORT=5432
APP_PORT=3000

# --- Prisma ---
# For `npm run dev` on your host, this is localhost. Inside docker compose the
# `web` service overrides DATABASE_URL to point at the `db` service.
DATABASE_URL="postgresql://erp:erp_secret@localhost:5432/student_erp?schema=public"

# --- Auth ---
# Used to sign session JWTs. Must be >= 32 chars. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"

# --- Seed admin ---
SEED_ADMIN_EMAIL="admin@college.edu"
SEED_ADMIN_PASSWORD="Admin@123"